# Copy this file to .env and fill in your values.

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# (a plain mysql://… URL from a hosting panel, like Railway's MYSQL_URL, works too)
# The database is created on first start if the MySQL user is allowed to (DB_AUTO_CREATE).
# MySQL older than 5.5 (e.g. old WAMP installs) does not know utf8mb4: use ?charset=utf8 there.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/klenz?charset=utf8mb4
DB_AUTO_CREATE=true

# Long random string that signs admin logins. Leave empty to auto-generate backend/.secret_key.
SECRET_KEY=

# First admin account, created on first start. An empty password generates one and prints it.
ADMIN_EMAIL=admin@klenz.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Add the three sample enquiries from the design on first start.
SEED_SAMPLE_DATA=true

# Only needed when the React site is hosted on a different domain than this API.
# CORS_ORIGINS=["https://www.example.com"]
